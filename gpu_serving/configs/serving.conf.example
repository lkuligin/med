# Copy to serving.conf and adjust for the box you are on:
#
#   cp gpu_serving/configs/serving.conf.example gpu_serving/configs/serving.conf
#
# Any GPU_SERVING_* environment variable overrides a value here.

# Cards this box lets us use. On the GPU box cards 0-3 belong to other people.
GPU_SERVING_CARDS="4,5,6,7"

# Where flat <org>/<name> weight directories are looked for, in order, like
# PATH. /mnt/data/models is the shared one and belongs to another user: we can
# read it, not add to it. Add your own directory after a colon if you keep
# weights in that layout too.
GPU_SERVING_MODELS_ROOTS="/mnt/data/models"

# The Hugging Face cache for everything not in a flat root: SGLang is handed
# the repo id and resolves it here, and "serve.sh fetch" downloads into it. It
# must be writable. /mnt/data/model (singular) is the box's shared cache, on
# the large array, already holding what the sglang-worker services use.
GPU_SERVING_HF_HOME="/mnt/data/model"

# The virtualenv holding sglang and sglang-router, built by setup_env.sh.
# A relative path is resolved against the package directory. Deliberately not
# the pipeline's venv: SGLang pins its own torch/CUDA stack.
GPU_SERVING_VENV=".venv"

# Where the server listens. Keep it on loopback: this is a shared machine, and
# 0.0.0.0 would hand the model to anyone who can reach the box.
GPU_SERVING_HOST="127.0.0.1"
GPU_SERVING_PORT="8000"

# Runtime state and server logs. Relative to the package. Listed in
# rsync-exclude.txt as remote-owned, so the mirror neither ships nor deletes it.
GPU_SERVING_RUN_DIR="run"

# Where SGLang keeps the kernels it compiles. An FP8 model spends minutes at
# startup warming DeepGEMM; that cost is paid once if this survives between
# runs. Keep it OUTSIDE the mirrored repository - the sync runs with --delete
# and would otherwise remove it, making the wait recur every time.
GPU_SERVING_KERNEL_CACHE="~/.cache/sglang"
