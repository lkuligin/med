# The notebook password, stored as an argon2 hash - never the password itself.
# Same shape as remote.conf and gateway.conf, so every secret lives in one kind
# of file. Copy this template only if you want to paste a hash you made
# yourself; normally the file is written for you by:
#
#   ./gdanschin_runtime/jupyter.sh --set-password
#
# SINGLE quotes are required, not double. An argon2 hash is full of '$', and in
# double quotes the shell expands $argon2id and friends into nothing, silently
# leaving a mangled hash that rejects every password.

JUPYTER_PASSWORD_HASH='paste-hash-here'
